{
  "name": "sonate-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Public SONATE SDK monorepo",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:schemas && npm run build:verify-sdk && npm run build:trust-receipts && npm run build --workspace=@sonate/sdk",
    "build:schemas": "npm run build --workspace=@sonate/schemas",
    "build:verify-sdk": "npm run build --workspace=@sonate/verify-sdk",
    "build:trust-receipts": "npm run build --workspace=@sonate/trust-receipts",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/s8ken/SONATE-SDK.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^25.0.3",
    "@types/winston": "^2.4.4",
    "c8": "^10.1.3",
    "glob": "^7.2.3",
    "jest": "^29.7.0",
    "json-canonicalize": "^2.0.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
