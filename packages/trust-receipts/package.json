{
  "name": "@sonate/trust-receipts",
  "version": "3.0.0",
  "description": "SSL/TLS for AI — cryptographically sign and verify every interaction (SONATE v2.2.0 receipts)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "node -e \"const fs=require('fs'); try{fs.rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "test": "vitest run",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sonate",
    "ai-trust",
    "trust-receipt",
    "ed25519",
    "ai-governance",
    "verifiable-ai",
    "ssl-for-ai",
    "audit-trail",
    "cryptographic-signatures",
    "openai",
    "anthropic",
    "llm",
    "ai-compliance"
  ],
  "author": "SONATE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s8ken/SONATE-SDK.git",
    "directory": "packages/trust-receipts"
  },
  "bugs": {
    "url": "https://github.com/s8ken/SONATE-SDK/issues"
  },
  "homepage": "https://github.com/s8ken/SONATE-SDK/tree/main/packages/trust-receipts#readme",
  "dependencies": {
    "@noble/ed25519": "^3.0.0",
    "json-canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@sonate/verify-sdk": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "openai": ">=4.0.0",
    "@anthropic-ai/sdk": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "import": "./dist/anchor.js",
      "require": "./dist/anchor.js"
    }
  },
  "files": [
    "dist",
    "!dist/tests",
    "fixtures",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
